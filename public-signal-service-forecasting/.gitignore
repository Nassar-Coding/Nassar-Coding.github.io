# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Testing and tooling caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Data directory: ignore generated/large files, but track the committed
# real input daily counts, its metadata, and the small real-schema CI sample.
data/raw/*
data/processed/*
data/metadata/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/metadata/.gitkeep
# Small provenance metadata (data source and weather source reports) is tracked
# as paper/reproducibility evidence; the processed dataset stays ignored (large).
!data/metadata/*.json
!data/raw/nyc_311_daily_counts_2022_2024.csv
!data/raw/nyc_311_daily_counts_2022_2024.meta.json
!data/raw/nyc_311_daily_counts_sample.csv
!data/raw/nyc_central_park_weather_2022_2024.csv
!data/raw/nyc_central_park_weather_sample.csv

# Generated model and report artifacts.
# Model binaries stay ignored (large, regenerable). Small report and figure
# evidence artifacts are committed for reproducibility and paper conversion.
models/*
!models/.gitkeep

reports/*
!reports/.gitkeep
!reports/*.json
!reports/*.csv

figures/*
!figures/.gitkeep
!figures/*.png

# OS / editor
.DS_Store
.idea/
.vscode/
