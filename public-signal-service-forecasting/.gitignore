# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Testing and tooling caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Generated data artifacts (regenerated by the pipeline)
data/raw/*
data/processed/*
data/metadata/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/metadata/.gitkeep

# Generated model and report artifacts
models/*
reports/*
figures/*
!models/.gitkeep
!reports/.gitkeep
!figures/.gitkeep

# OS / editor
.DS_Store
.idea/
.vscode/
